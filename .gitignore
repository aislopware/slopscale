logs/

*.prof

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
vendor/

dist/
# The admin console bundle is built by `make web`; keep the directory so
# the go:embed pattern in web/embed.go matches on a fresh checkout.
!/web/dist/
/web/dist/*
!/web/dist/.gitkeep
/headscale
config.yaml
config*.yaml
!config-example.yaml
derp.yaml
*.hujson
!hscontrol/policy/v2/testdata/*/*.hujson
*.key
/db.sqlite
*.sqlite3

# Exclude Jetbrains Editors
.idea

test_output/
control_logs/

# Nix build output
result
.direnv/

integration_test/etc/config.dump.yaml

# OpenAPI spec is served live from the code and emitted on demand, not committed
/openapi/v1/headscale.yaml

# MkDocs
.cache
/site

__debug_bin

# Stray npm files at the repository root; the admin console's own live in web/.
node_modules/
/package-lock.json
/package.json

# Local secrets (Google OAuth client for the console)
.env
