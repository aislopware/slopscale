# Minimal CI image - expects pre-built slopscale binary in build context
# For local development with delve debugging, use Dockerfile.integration instead

FROM debian:trixie-slim

RUN apt-get --update install --no-install-recommends --yes \
    bash ca-certificates curl dnsutils findutils iproute2 jq less procps python3 sqlite3 \
  && apt-get dist-clean

RUN mkdir -p /var/run/slopscale

# Copy pre-built slopscale binary from build context
COPY slopscale /usr/local/bin/slopscale

ENTRYPOINT []
EXPOSE 8080/tcp
CMD ["/usr/local/bin/slopscale"]
